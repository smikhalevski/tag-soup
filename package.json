{
  "name": "tag-soup",
  "version": "3.2.0",
  "description": "The fastest pure JS SAX/DOM XML/HTML parser.",
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc --project tsconfig.build.json && cp package.json README.md LICENSE.txt lib/ && cd lib && npm pkg delete scripts devDependencies",
    "clean": "rimraf lib docs coverage",
    "test": "vitest run",
    "typecheck": "tsc",
    "lint": "oxlint --tsconfig tsconfig.json src/main",
    "format": "oxfmt 'src/**/*.{ts,js}'",
    "perf": "NODE_OPTIONS=--expose-gc toofast",
    "docs": "typedoc"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smikhalevski/tag-soup.git"
  },
  "keywords": [
    "tiny",
    "forgiving",
    "stream",
    "fast",
    "sax",
    "dom",
    "html",
    "xml",
    "parser"
  ],
  "author": "Savva Mikhalevski <smikhalevski@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/smikhalevski/tag-soup/issues"
  },
  "homepage": "https://github.com/smikhalevski/tag-soup#readme",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "fast-xml-parser": "^5.12.0",
    "htmlparser-benchmark": "^1.1.3",
    "htmlparser2": "^12.0.0",
    "hyntax": "^1.1.9",
    "parse5": "^8.1.0",
    "parse5-sax-parser": "^8.0.0",
    "rimraf": "^6.1.4",
    "toofast": "^4.1.0",
    "tslib": "^2.9.1",
    "typedoc": "^0.28.20",
    "typedoc-plugin-mdn-links": "^5.1.1",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "flyweight-dom": "^3.0.0",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "speedy-entities": "^4.0.0"
  }
}
